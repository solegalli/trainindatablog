---
layout: null
---
[
  {% for post in site.posts %}
  {% assign author = site.authors[post.author] %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | absolute_url | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncatewords: 20 | jsonify }},
    "image": {% if post.image %}{{ post.image | relative_url | jsonify }}{% else %}null{% endif %},
    "date": {{ post.date | date_to_string | jsonify }},
    "author": {% if author %}{{ author.display_name | jsonify }}{% else %}{{ site.author | jsonify }}{% endif %},
    "categories": {{ post.categories | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
